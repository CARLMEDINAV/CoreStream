# =====================================================================
# Variables de entorno para el docker-compose.yml de la raíz (producción)
# =====================================================================
# Copiar a ".env" en este mismo directorio y rellenar con valores reales
# ANTES de levantar los contenedores. Este fichero (.env) nunca debe llegar
# al repositorio — ya está en .gitignore — y en la VM debería vivir con
# permisos restringidos (chmod 600) fuera del árbol si es posible.
#
# backend/.env y frontend/.env son para desarrollo local SIN Docker; este
# docker-compose.yml no los lee — todo lo que el backend necesita se le
# pasa aquí, en la sección "environment" de cada servicio.
# =====================================================================

# -----------------------------------------------------------------------
# Puertos publicados en 0.0.0.0, igual que el resto de proyectos de esta
# VM (no hay Nginx local — el enrutamiento público lo gestiona algo fuera
# de esta máquina). 8010 en vez de 8000 porque otro proyecto de la VM ya
# usa 8000. Ver docs/DEPLOYMENT.md.
# -----------------------------------------------------------------------
BACKEND_PORT=8010
FRONTEND_PORT=8080

# -----------------------------------------------------------------------
# PostgreSQL y Redis: NO son contenedores propios en producción — esta VM
# ya tiene ambos corriendo, compartidos con otros proyectos (contenedores
# db-postgre y directa-redis-1). CoreStream usa su propia base/usuario
# dentro de esa misma instancia de Postgres — ver docs/DEPLOYMENT.md para
# cómo crearlos. redis:// sin autenticación porque esa instancia no tiene
# contraseña configurada; el aislamiento real lo dan los prefijos
# "corestream:" en claves y canales (ver app/redis_client.py).
# -----------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://corestream:CAMBIAR-en-.env@10.0.0.19:5432/corestream
REDIS_URL=redis://10.0.0.19:6379/5

# -----------------------------------------------------------------------
# Autenticación (backend)
# -----------------------------------------------------------------------
# Generar con: openssl rand -hex 32 — el arranque ABORTA si esto no cambia
# y ENVIRONMENT=production (ver app/config.py, validate_production_settings).
SECRET_KEY=cambiar-esta-clave-por-una-generada
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------
# Entorno
# -----------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info
APP_NAME=CoreStream API

# Dominio real desde el que se sirve el frontend. Sin esquema duplicado ni
# barra final. Con ENVIRONMENT=production, ALLOWED_ORIGINS con "*" aborta
# el arranque (no se puede combinar con allow_credentials=True).
ALLOWED_ORIGINS=https://corestream.alloxentric.com

# IP(s) desde las que se acepta X-Forwarded-For / X-Forwarded-Proto.
#
# Con "*" uvicorn confía en esa cabecera venga de donde venga, y entonces el
# cliente decide qué IP se registra. Eso afecta a dos cosas:
#   - el rate limiting de /auth/login es por IP: rotando la cabecera se salta
#     el límite de 20 intentos/5min por completo;
#   - la columna `ip` de audit_logs (TRV-07) deja de ser prueba de nada.
#
# Esta VM no es alcanzable desde internet, pero sí desde su red privada —
# donde conviven los contenedores de los otros proyectos. Poner aquí la IP o
# el CIDR del proxy que termina TLS es lo que convierte ambas cosas en fiables.
#
# Con ENVIRONMENT=production el arranque FALLA si se deja en "*" o vacío, igual
# que con SECRET_KEY o ALLOWED_ORIGINS=*. En desarrollo el comodín vale.
# Acepta una IP, un CIDR, o varios separados por coma. Ver docs/DEPLOYMENT.md.
FORWARDED_ALLOW_IPS=10.0.0.0/24

# -----------------------------------------------------------------------
# Auditoría (TRV-07)
# -----------------------------------------------------------------------
# Destinos a los que se deriva cada evento auditable, separados por coma:
#   database   OBLIGATORIO. La tabla audit.audit_logs — el almacén que se
#              consulta, exporta y purga. Sin él el arranque falla.
#   logstream  Línea JSON por stdout. Es lo que recoge el driver de logs de
#              Docker, así que es la vía para CloudWatch (driver awslogs),
#              Cloud Logging (gcplogs) o un Logstash/Fluent Bit delante.
#   elastic    Envío directo a Elasticsearch desde la aplicación.
#
# El criterio 2 de TRV-07 pide derivar a un motor especializado (ELK o
# CloudWatch). Para ELK hay dos caminos: añadir "elastic" aquí, o dejar solo
# "logstream" y apuntar el driver de Docker a un Logstash. Ver docs/RBAC.md.
AUDIT_SINKS=database,logstream

# ¿Se auditan también las lecturas con éxito? La descripción de TRV-07 dice
# "todo evento de la plataforma", así que sí por defecto: queda registrado
# quién consultó qué, no solo quién modificó.
#
# Coste medido: la entrada se escribe dentro de la petición, y eso es una ida
# y vuelta más a Postgres por cada GET (el INSERT en sí son ~3 ms; el resto es
# la latencia de red hacia la base). Con el destino de Elasticsearch activo se
# suma además un envío HTTP por petición — para tráfico alto, la ruta sin
# latencia es el driver de logs de Docker en lugar del sink "elastic".
#
# En false se registran solo las mutaciones, los 401/403/429 de cualquier
# verbo y /api/auth/*. Las sondas quedan fuera en ambos casos.
AUDIT_READS=true

# Días que se conserva la auditoría de cada cliente, según su plan (TRV-08).
#
# PENDIENTE DE CONFIRMAR POR NEGOCIO. Estos valores son una propuesta del
# equipo de desarrollo, no una decisión tomada: cuánto se conserva el registro
# de un cliente es parte de lo que se le vende y puede estar condicionado por
# obligaciones legales de conservación. Cambiarlos no requiere desplegar.
#
# Si una variable se deja vacía se usa el valor base del código (30/180/730).
# Un valor no numérico o menor que 1 impide arrancar, para que un error de
# escritura no degrade la retención en silencio.
AUDIT_RETENTION_DAYS_BASICO=30
AUDIT_RETENTION_DAYS_PRO=180
AUDIT_RETENTION_DAYS_ENTERPRISE=730

# Solo si "elastic" está entre los AUDIT_SINKS. Con elastic activado y la URL
# vacía, el arranque falla: una derivación sin destino es peor que ninguna.
#
# Con el perfil elk de este repositorio (docker compose --profile elk up -d),
# Elasticsearch no publica puerto: solo lo alcanzan los contenedores de este
# compose, por nombre de servicio. Entonces:
#   ELASTIC_URL=http://elasticsearch:9200
#   ELASTIC_USERNAME=elastic
#   ELASTIC_PASSWORD=<la misma de abajo>
# Con Elastic Cloud se usa ELASTIC_API_KEY en lugar de usuario/contraseña.
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_INDEX=corestream-audit

# Número de procesos de uvicorn — ajustar a los núcleos de la VM.
UVICORN_WORKERS=4

# -----------------------------------------------------------------------
# Traducción de documentos (Azure Cognitive Services) — opcional. Si se
# deja vacío, la función de traducir documentos se desactiva limpiamente
# (no da 502, ver plan fase 8).
# -----------------------------------------------------------------------
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=eastus

# -----------------------------------------------------------------------
# Frontend (solo en tiempo de build; Vite las incrusta en el bundle)
# -----------------------------------------------------------------------
# Vacío = usar '/api' (correcto cuando el mismo Nginx sirve front y proxya
# /api hacia el backend, que es el caso previsto). Solo cambiar si el
# frontend se sirve desde un dominio distinto al del backend.
VITE_API_BASE_URL=
